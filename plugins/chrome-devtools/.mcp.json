{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--isolated",
        "--headless",
        "--blockedUrlPattern",
        "file:///*",
        "--fileNavigations=false",
        "--redactNetworkHeaders",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
