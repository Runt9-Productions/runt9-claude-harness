#!/usr/bin/env bash
# Two checks in turn. The authorship check refuses, from a Claude Code session, a push of a commit the bot (git config
# claude.botName and claude.botEmail) did not both author and commit, and a push or deletion of a ref outside the
# bot's branch prefix. The leak gate then refuses a push that would publish private information: the shape scan runs
# first, and the public-leak agent reviews whatever the scan passes. Any error refuses the push.
#
# They stop the mistakes of an agent pushing as a bot. They are no boundary against a process running as the same
# user, which can skip any hook; review before merge is. Run an installed copy, never the checkout's: see README.md. On
# an SSH remote LEAK_SCAN_SKIP=1 skips the leak gate; on any other transport it refuses the push.
#
# stdin, one line per ref: <local ref> <local sha> <remote ref> <remote sha>
set -Eeuo pipefail
trap 'echo "pre-push: failed at line $LINENO, push refused" >&2; exit 1' ERR

url=$2
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=${here%/*}
mapfile -t updates

# Inert where git config sets no claude.botEmail, and outside a session: CLAUDE_CODE_SESSION_ID is the only sign that
# the agent, not its owner, is pushing.
bot_email=$(git config --get claude.botEmail || true)
if [[ -n $bot_email && -n ${CLAUDE_CODE_SESSION_ID:-} ]]; then
    bot_name=$(git config --get claude.botName || true)
    if [[ -z $bot_name ]]; then
        echo "pre-push: claude.botEmail is set but claude.botName is not; set both or neither. Push refused" >&2
        exit 1
    fi
    bot="$bot_name <$bot_email>"
    # git config prints an empty value with exit 0, which would make the prefix match every branch.
    prefix=$(git config --get claude.branchPrefix || true)
    prefix=${prefix:-claude/}
    misnamed=0
    misidentified=0
    for update in "${updates[@]}"; do
        read -r _ local_sha remote_ref remote_sha <<< "$update"
        if [[ $remote_ref != refs/heads/"$prefix"* ]]; then
            echo "pre-push: the bot pushes and deletes only branches under $prefix, not $remote_ref" >&2
            misnamed=1
            continue
        fi
        if [[ $local_sha =~ ^0+$ ]]; then
            continue
        fi
        # Only what no remote-tracking ref of any remote has. A range from remote_sha alone would also hold every
        # commit a merge brings in from another branch, such as the owner's commits on main. remote_sha is excluded as
        # well for a remote pushed to by URL, which has no tracking refs.
        exclude=(--not --remotes)
        if [[ ! $remote_sha =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
            exclude+=("$remote_sha")
        fi
        identities=$(git log --format='%H%x09%an <%ae>%x09%cn <%ce>' "$local_sha" "${exclude[@]}")
        while IFS=$'\t' read -r sha author committer; do
            # An empty range still gives one empty line.
            [[ -n $sha ]] || continue
            if [[ $author != "$bot" ]]; then
                echo "pre-push: $sha on $remote_ref is authored by $author, not by the bot $bot" >&2
                misidentified=1
            fi
            if [[ $committer != "$bot" ]]; then
                echo "pre-push: $sha on $remote_ref is committed by $committer, not by the bot $bot" >&2
                misidentified=1
            fi
        done <<< "$identities"
    done
    if (( misnamed )); then
        echo "pre-push: push to a branch under $prefix and open a pull request from it" >&2
    fi
    if (( misidentified )); then
        echo "pre-push: re-author those commits as the bot before pushing, with the remote's default branch as the" \
            "base so no commit already on it is rewritten, for example" \
            "git -c user.name='$bot_name' -c user.email='$bot_email'" \
            "rebase --exec 'git commit --amend --no-edit --reset-author' $1/main" >&2
    fi
    if (( misnamed || misidentified )); then
        echo "pre-push: the authorship check refused this push" >&2
        exit 1
    fi
fi

if [[ ${LEAK_SCAN_SKIP:-} == 1 ]]; then
    if [[ $url == git@* || $url == ssh://* ]]; then
        echo "pre-push: leak checks skipped (LEAK_SCAN_SKIP on an SSH remote)" >&2
        exit 0
    fi
    echo "pre-push: LEAK_SCAN_SKIP works only on an SSH remote, and $url is not one" >&2
    exit 1
fi

tips=()
pushed_refs=()
for update in "${updates[@]}"; do
    read -r _ local_sha remote_ref remote_sha <<< "$update"
    # Deleting a ref, or pushing a tip the remote already has, publishes nothing.
    if [[ $local_sha =~ ^0+$ || $local_sha == "$remote_sha" ]]; then
        continue
    fi
    tips+=("$local_sha")
    pushed_refs+=("$remote_ref")
done
if (( ${#tips[@]} == 0 )); then
    exit 0
fi

# The pass cache and the review's working files live in the install directory, which the agent's write guards cover.
# In the repository's .git or in /tmp, an agent could plant a pass or edit the review's inputs.
state=$root/state
mkdir -p "$state/passed"
work=$(mktemp -d "$state/push.XXXXXX")
trap 'rm -rf "$work"' EXIT

# Everything below reads a bare mirror that borrows the repo's objects and holds the remote's refs as fetched now, so
# what counts as already published never depends on stale or misnamed remote-tracking refs.
mirror=$work/mirror
mirror_git() {
    git --git-dir="$mirror" "$@"
}
object_format=$(git rev-parse --show-object-format)
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
git init -q --bare --object-format="$object_format" "$mirror"
echo "$common_dir/objects" > "$mirror/objects/info/alternates"

# Run from the repo, so a relative remote path resolves as the push resolved it.
if ! mirror_git fetch -q --no-tags "$url" +HEAD:refs/trusted \
    '+refs/heads/*:refs/remote/heads/*' '+refs/tags/*:refs/remote/tags/*' 2> "$work/fetch.err"; then
    echo "pre-push: cannot fetch the default branch of $url, push refused" >&2
    cat "$work/fetch.err" >&2
    exit 1
fi
# The remote's default branch is reviewed content, so the allowlist and the review's instructions come from it.
trusted=$(mirror_git rev-parse --verify 'refs/trusted^{commit}')
published=$(mirror_git for-each-ref --format='^%(objectname)' refs/trusted refs/remote/)
mapfile -t published <<< "$published"
# What the push publishes: everything the pushed tips reach that no ref on the remote already does.
revisions=("${tips[@]}" "${published[@]}")

ref_args=()
for ref in "${pushed_refs[@]}"; do
    ref_args+=(--ref "$ref")
done
scanned=$work/scanned
status=0
"$root/leak-scan/scan.sh" "${ref_args[@]}" --export "$scanned" "$mirror" "$trusted" "${revisions[@]}" || status=$?
if (( status == 1 )); then
    echo "pre-push: the leak scan flagged this push, push refused" >&2
    exit 1
fi
if (( status != 0 )); then
    echo "pre-push: the leak scan did not run, push refused" >&2
    exit 1
fi

bundle=$work/review
mkdir "$bundle"

# Read pages by whole lines and refuses a line past its 25,000-token cap. Longer lines are split into overlapping
# pieces, so the review can read all of one, and text cut at a split is still whole in the next piece.
split_long_lines() {
    awk -v width=4000 -v overlap=200 '
        length($0) <= width { print; next }
        {
            for (start = 1; ; start += width - overlap) {
                print substr($0, start, width)
                if (start + width > length($0)) break
            }
        }'
}

# The review reads exactly what the scan read. The patch already holds each commit's message, so of the per-commit
# text files only the identities, which carry the committer, are added.
split_long_lines < "$scanned/patch" > "$bundle/commits.patch"
split_long_lines < "$scanned/binary-files" > "$bundle/binary-files.txt"
split_long_lines < "$scanned/text/file-names" > "$bundle/file-names.txt"
split_long_lines < "$scanned/text/ref-names" > "$bundle/ref-names.txt"
shopt -s nullglob
for identity in "$scanned"/text/*.identity; do
    cat "$identity"
done | sort -u | split_long_lines > "$bundle/identities.txt"
for tag in "$scanned"/text/*.tag; do
    cat "$tag"
    echo
done | split_long_lines > "$bundle/tags.txt"
shopt -u nullglob
inputs=()
for input in commits.patch identities.txt file-names.txt binary-files.txt tags.txt ref-names.txt; do
    if [[ -s $bundle/$input ]]; then
        inputs+=("$input")
    else
        rm "$bundle/$input"
    fi
done

for path in .claude/agents/code-review/public-leak.md .claude/agents/references/reviewer-brief.md \
    .claude/code-review-profile.md CLAUDE.md; do
    if mirror_git cat-file -e "$trusted:$path" 2> /dev/null; then
        mirror_git cat-file blob "$trusted:$path" > "$bundle/${path##*/}"
    fi
done
agent_file=$bundle/public-leak.md
if [[ ! -f $agent_file ]]; then
    echo "pre-push: the default branch of $url has no .claude/agents/code-review/public-leak.md, push refused" >&2
    exit 1
fi

# A pass holds only for this content under this gate, so changing any installed file invalidates every pass.
key=$( { (cd "$root" && find githooks leak-scan -type f -print0 | sort -z | xargs -0 sha256sum)
         (cd "$bundle" && sha256sum -- *); } | sha256sum | cut -d' ' -f1)
passed=$state/passed/$key
if [[ -f $passed ]]; then
    echo "pre-push: this change already passed the leak review" >&2
    exit 0
fi

# Severity enum and field names are read by the jq calls below.
schema='{
  "type": "object", "additionalProperties": false, "required": ["findings", "open_questions", "read"],
  "properties": {
    "findings": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["severity", "location", "text", "reveals"],
      "properties": {"severity": {"enum": ["Critical", "High", "Normal"]}, "location": {"type": "string"},
                     "text": {"type": "string"}, "reveals": {"type": "string"}}}},
    "open_questions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["location", "text", "question"],
      "properties": {"location": {"type": "string"}, "text": {"type": "string"}, "question": {"type": "string"}}}},
    "read": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["file", "lines"],
      "properties": {"file": {"type": "string"}, "lines": {"type": "integer"}}}}
  }
}'

request="Review what this push would publish. Its inputs are the files in this directory from this list: \
commits.patch (each commit's header, message and changed lines, without context; a merge shows only what it adds \
beyond git's own merge of its parents), identities.txt (every author and committer name and email), file-names.txt \
(every path it touches), binary-files.txt (commit and path of each binary file, whose content neither you nor the \
pattern scan can read; raise an open question for each), tags.txt (annotated tags) and ref-names.txt (the branch \
and tag names it creates or updates). In the input files, a line longer than 4000 characters is split into pieces \
of 4000 that overlap by 200. The reviewer brief is reviewer-brief.md, and the repository's review profile and \
CLAUDE.md, where it has them, are code-review-profile.md and CLAUDE.md, all here. Read every input file to its last \
line, in pages where it is long, and give each one's name and the last line number you read of it in read. Report \
every finding and open question in the structured output."

if [[ $(head -n 1 "$agent_file") != --- ]]; then
    echo "pre-push: public-leak.md on the default branch of $url does not start with frontmatter, push refused" >&2
    exit 1
fi
# frontmatter_field <key>: the value of `key: value` between the agent file's opening `---` and the next one. It reads
# one line and keeps any quotes, so public-leak.md must give `description`, `model` and `effort` as single unquoted lines.
frontmatter_field() {
    sed -n "2,/^---\$/s/^$1: //p" "$agent_file"
}
model=$(frontmatter_field model)
effort=$(frontmatter_field effort)
jq -n --arg description "$(frontmatter_field description)" --arg prompt "$(sed '1,/^---$/d' "$agent_file")" \
    '{"public-leak": {description: $description, prompt: $prompt}}' > "$work/agents.json"

# The review gets only these variables, so nothing the caller sets can redirect or alter it: not ANTHROPIC_BASE_URL, a
# proxy, NODE_OPTIONS or a plugin directory. The auth variables name a credential, never where it is sent.
review_env=(PATH="$PATH" HOME="$HOME")
for name in USER LOGNAME LANG LC_ALL LC_CTYPE ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN; do
    if [[ -n ${!name:-} ]]; then
        review_env+=("$name=${!name}")
    fi
done

# --restricted confines Read to the bundle and loads no CLAUDE.md, so the review reads only what this hook put there.
# MCP servers and every tool but Read stay out.
status=0
(cd "$bundle" && env -i "${review_env[@]}" timeout 900 claude -p --restricted --agent public-leak \
    --agents "$work/agents.json" --setting-sources project --strict-mcp-config --tools Read \
    --model "${model:-opus}" --effort "${effort:-high}" --no-session-persistence --output-format json --json-schema "$schema" \
    "$request" < /dev/null > "$work/result.json" 2> "$work/claude.stderr") || status=$?
if (( status != 0 )) || ! jq -e '.structured_output | objects' "$work/result.json" > /dev/null; then
    echo "pre-push: the leak review did not run (claude exited $status), push refused" >&2
    cat "$work/claude.stderr" >&2
    exit 1
fi

jq -r '.structured_output
    | (.findings[] | "\(.severity)  \(.location)\n  \(.text)\n  \(.reveals)"),
      (.open_questions[] | "Question  \(.location)\n  \(.text)\n  \(.question)")' "$work/result.json" >&2

for input in "${inputs[@]}"; do
    lines=$(wc -l < "$bundle/$input")
    read_lines=$(jq --arg file "$input" '[.structured_output.read[] | select(.file == $file) | .lines] | max // 0' \
        "$work/result.json")
    if (( read_lines < lines )); then
        echo "pre-push: the leak review read $read_lines of the $lines lines in $input, push refused" >&2
        exit 1
    fi
done

blocking=$(jq '.structured_output
    | ([.findings[] | select(.severity != "Normal")] | length) + (.open_questions | length)' "$work/result.json")
if (( blocking > 0 )); then
    echo "pre-push: the leak review raised $blocking question(s) or finding(s) not rated Normal, push refused" >&2
    exit 1
fi
touch "$passed"
